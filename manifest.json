{
  "manifest_version": 3,
  "name": "MonkeySkill",
  "version": "0.2.0",
  "description": "Install site-specific browser abilities from MSkill specifications, including builds generated with your own LLM API.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "userScripts"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "MonkeySkill"
  },
  "options_page": "src/options/options.html"
}
