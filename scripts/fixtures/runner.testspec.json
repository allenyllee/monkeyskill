{
  "schemaVersion": 1,
  "tests": [
    {
      "id": "context-menu-listener",
      "kind": "behavior",
      "criterion": "context-menu",
      "mode": "standard",
      "fixture": { "nodes": [{ "id": "target", "tag": "div", "parent": null, "text": "target", "attributes": {}, "styles": {} }], "rules": [] },
      "blockers": [{ "id": "block", "target": "target", "event": "contextmenu", "registration": "listener", "effect": "prevent-default", "when": { "button": 2 } }],
      "steps": [{ "action": "dispatch-event", "target": "target", "event": "contextmenu", "init": { "button": 2 } }],
      "assertions": [
        { "type": "event-default-prevented", "step": 0, "expected": false }
      ]
    },
    {
      "id": "text-selection",
      "kind": "behavior",
      "criterion": "text-selection",
      "mode": "standard",
      "fixture": { "nodes": [{ "id": "target", "tag": "div", "parent": null, "text": "select me", "attributes": {}, "styles": { "userSelect": "none" } }], "rules": [] },
      "blockers": [
        { "id": "down-block", "target": "target", "event": "mousedown", "registration": "inline", "effect": "prevent-default", "when": { "button": 0 } },
        { "id": "select-block", "target": "target", "event": "selectstart", "registration": "listener", "effect": "prevent-default", "when": {} }
      ],
      "steps": [
        { "action": "wait", "ms": 50 },
        { "action": "drag-select-text", "target": "target" }
      ],
      "assertions": [
        { "type": "computed-style", "target": "target", "property": "userSelect", "pseudo": null, "operator": "neq", "value": "none" },
        { "type": "event-default-prevented", "step": 1, "expected": false },
        { "type": "selection-collapsed", "expected": false }
      ]
    },
    {
      "id": "keyboard-copy",
      "kind": "behavior",
      "criterion": "keyboard-copy",
      "mode": "standard",
      "fixture": { "nodes": [{ "id": "target", "tag": "input", "parent": null, "text": "", "attributes": { "value": "copy me" }, "styles": {} }], "rules": [] },
      "blockers": [{ "id": "block", "target": "target", "event": "keydown", "registration": "listener", "effect": "prevent-default", "when": { "key": "c", "ctrlKey": true } }],
      "steps": [{ "action": "copy-shortcut", "target": "target", "operation": "copy" }],
      "assertions": [
        { "type": "event-default-prevented", "step": 0, "expected": false }
      ]
    },
    {
      "id": "keyboard-copy-property-return-false",
      "kind": "behavior",
      "criterion": "keyboard-copy",
      "mode": "standard",
      "fixture": { "nodes": [{ "id": "target", "tag": "input", "parent": null, "text": "", "attributes": { "value": "copy me" }, "styles": {} }], "rules": [] },
      "blockers": [{ "id": "block", "target": "target", "event": "keydown", "registration": "property", "effect": "return-false", "when": { "key": "c", "ctrlKey": true } }],
      "steps": [{ "action": "copy-shortcut", "target": "target", "operation": "copy" }],
      "assertions": [
        { "type": "event-default-prevented", "step": 0, "expected": false },
        { "type": "value", "target": "target", "operator": "eq", "value": "copy me" }
      ]
    },
    {
      "id": "paste-event",
      "kind": "behavior",
      "criterion": "paste",
      "mode": "absolute",
      "fixture": { "nodes": [{ "id": "target", "tag": "input", "parent": null, "text": "", "attributes": {}, "styles": {} }], "rules": [] },
      "blockers": [
        { "id": "block", "target": "target", "event": "paste", "registration": "listener", "effect": "prevent-default", "when": {} },
        { "id": "rollback", "target": "target", "event": "input", "registration": "listener", "effect": "rollback-value", "when": { "inputType": "insertFromPaste" } }
      ],
      "steps": [{ "action": "paste-text", "target": "target", "value": "pasted text" }],
      "assertions": [
        { "type": "event-default-prevented", "step": 0, "expected": false },
        { "type": "value", "target": "target", "operator": "eq", "value": "pasted text" }
      ]
    },
    {
      "id": "pointer-overlays",
      "kind": "behavior",
      "criterion": "pointer-overlays",
      "mode": "absolute",
      "fixture": {
        "nodes": [
          { "id": "wrap", "tag": "div", "parent": null, "text": "", "attributes": {}, "styles": { "position": "relative", "width": "240px", "height": "120px" } },
          { "id": "target", "tag": "canvas", "parent": "wrap", "text": "", "attributes": {}, "styles": { "width": "240px", "height": "120px" }, "rect": { "x": 8, "y": 8, "width": 240, "height": 120 } },
          { "id": "overlay", "tag": "div", "parent": "wrap", "text": "", "attributes": {}, "styles": { "position": "absolute", "inset": "0" }, "rect": { "x": 8, "y": 8, "width": 240, "height": 120 } }
        ],
        "rules": []
      },
      "blockers": [],
      "steps": [{ "action": "wait", "ms": 1600 }],
      "assertions": [
        { "type": "hit-test", "target": "target", "expected": true, "point": "center" }
      ]
    },
    {
      "id": "selection-visible",
      "kind": "behavior",
      "criterion": "selection-visibility",
      "mode": "absolute",
      "fixture": {
        "nodes": [{ "id": "target", "tag": "span", "parent": null, "text": "visible selection", "attributes": {}, "styles": {} }],
        "rules": [{ "target": "target", "pseudo": "::selection", "specificity": "id-ancestor", "styles": { "backgroundColor": "transparent" } }]
      },
      "blockers": [],
      "steps": [{ "action": "wait", "ms": 50 }],
      "assertions": [
        { "type": "computed-style", "target": "target", "property": "backgroundColor", "pseudo": "::selection", "operator": "neq", "value": "rgba(0, 0, 0, 0)" },
        { "type": "computed-style", "target": "target", "property": "backgroundColor", "pseudo": "::selection", "operator": "neq", "value": "transparent" }
      ]
    },
    {
      "id": "selection-dismissal",
      "kind": "behavior",
      "criterion": "selection-dismissal",
      "mode": "absolute",
      "fixture": {
        "nodes": [
          { "id": "selected-text", "tag": "p", "parent": null, "text": "selected page text", "attributes": {}, "styles": {} },
          { "id": "page-area", "tag": "div", "parent": null, "text": "ordinary page area", "attributes": {}, "styles": { "minHeight": "40px" } },
          { "id": "next-text", "tag": "p", "parent": null, "text": "a different selectable passage", "attributes": {}, "styles": {} }
        ],
        "rules": []
      },
      "blockers": [],
      "steps": [
        { "action": "drag-select-text", "target": "selected-text" },
        { "action": "click-page", "target": "page-area" },
        { "action": "drag-select-text", "target": "next-text" }
      ],
      "assertions": [
        { "type": "event-default-prevented", "step": 1, "expected": false },
        { "type": "selection-collapsed", "step": 1, "expected": true },
        { "type": "selection-collapsed", "step": 2, "expected": false },
        { "type": "selection-write-count", "step": 2, "operator": "lte", "value": 5 }
      ]
    },
    {
      "id": "ordinary-controls",
      "kind": "behavior",
      "criterion": "preserve-controls",
      "mode": "absolute",
      "fixture": {
        "nodes": [
          { "id": "selected-text", "tag": "p", "parent": null, "text": "selected page text", "attributes": {}, "styles": {} },
          { "id": "target", "tag": "input", "parent": null, "text": "", "attributes": {}, "styles": {} }
        ],
        "rules": []
      },
      "blockers": [{ "id": "observer", "target": "target", "event": "click", "registration": "listener", "effect": "flag-only", "when": { "button": 0 } }],
      "steps": [
        { "action": "drag-select-text", "target": "selected-text" },
        { "action": "click-control", "target": "target" },
        { "action": "set-value", "target": "target", "value": "ordinary input" }
      ],
      "assertions": [
        { "type": "blocker-call-count", "blocker": "observer", "operator": "eq", "value": 1 },
        { "type": "event-default-prevented", "step": 1, "expected": false },
        { "type": "selection-collapsed", "expected": true },
        { "type": "active-element", "target": "target", "expected": true },
        { "type": "value", "target": "target", "operator": "eq", "value": "ordinary input" }
      ]
    },
    {
      "id": "deny-network",
      "kind": "policy",
      "criterion": "no-network",
      "capability": "network",
      "expected": "denied"
    }
  ]
}
